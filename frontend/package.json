    "@sentry/nextjs": "^10.51.0",
    "date-fns": "^4.1.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.4",
    "react-joyride": "^3.0.2",
    "recharts": "^3.8.1"
